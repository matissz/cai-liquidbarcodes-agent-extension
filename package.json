{
  "name": "cai-liquidbarcodes-agent-extension",
  "version": "1.0.4",
  "description": "Cognigy Extension for Liquid Barcodes Agent API integration",
  "main": "build/bundle.js",
  "files": [
    "build/",
    "package-lock.json",
    "icon.png",
    "README.md"
  ],
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "pack:cognigy": "webpack --mode production && node scripts/pack.js",
    "test": "jest --runInBand --testPathIgnorePatterns=src/__tests__/integration/",
    "test:auth": "jest --runInBand src/__tests__/auth",
    "test:nodes": "jest --runInBand src/__tests__/nodes",
    "test:utils": "jest --runInBand src/__tests__/utils",
    "test:module": "jest --runInBand src/__tests__/module",
    "test:security": "jest --runInBand src/__tests__/security",
    "test:integration": "jest --runInBand src/__tests__/integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=src/__tests__/integration/",
    "test:coverage:detailed": "jest --coverage --verbose --testPathIgnorePatterns=src/__tests__/integration/",
    "test:ci": "jest --coverage --ci --runInBand --testPathIgnorePatterns=src/__tests__/integration/"
  },
  "keywords": [
    "cognigy",
    "extension",
    "liquid-barcodes",
    "agent-api",
    "loyalty",
    "cai"
  ],
  "author": "Circle K Europe - Global Tech",
  "license": "UNLICENSED",
  "dependencies": {
    "@cognigy/extension-tools": "^0.17.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.0",
    "typescript": "^5.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
